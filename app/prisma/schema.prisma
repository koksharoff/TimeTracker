generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int         @id @default(autoincrement())
  username  String
  password  String?
  time      TimeRecord[]
}

model TimeRecord {
  id      Int      @id @default(autoincrement())
  minutes Int
  date    DateTime
  note    String?
  userId  Int?
  user    User?    @relation(fields: [userId], references: [id])
}

model Event {
  id               Int      @id @default(autoincrement())
  event            String
  eventTimestamp   DateTime @map("event_timestamp")
  elapsedMs        Int      @map("elapsed_ms")
  activeTimeMs     Int      @map("active_time_ms")
  filePath         String?  @map("file_path")
  fileLanguage     String?  @map("file_language")
  fileName         String?  @map("file_name")
  workspaceFolder  String?  @map("workspace_folder")
  sessionHostname  String   @map("session_hostname")
  sessionUserName  String   @map("session_user_name")
  sessionStartedAt DateTime @map("session_started_at")
  githubLogin      String?  @map("github_login")
  displayName      String?  @map("display_name")

  @@index([eventTimestamp])
  @@index([sessionUserName])
}

model Commit {
  id              Int      @id @default(autoincrement())
  hash            String   @unique
  repository      String
  branch          String?
  message         String
  authoredAt      DateTime @map("authored_at")
  sessionUserName String   @map("session_user_name")
  githubLogin     String?  @map("github_login")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([authoredAt])
  @@index([sessionUserName])
}
